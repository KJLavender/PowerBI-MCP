/// 商品
table DIM_PRODUCT

	column PRODUCT_ID
		dataType: int64
		isHidden
		sourceColumn: PRODUCT_ID

	/// 商品代碼
	column PRODUCT_CODE
		dataType: string
		sourceColumn: PRODUCT_CODE

	/// 商品名稱
	column PRODUCT_NAME
		dataType: string
		sourceColumn: PRODUCT_NAME

	/// 商品大類
	column CATEGORY
		dataType: string
		sourceColumn: CATEGORY

	/// 品牌
	column BRAND
		dataType: string
		sourceColumn: BRAND

	/// 牌價
	column LIST_PRICE
		dataType: decimal
		formatString: #,##0
		sourceColumn: LIST_PRICE

	/// 標準成本（主檔，實際成本以 FACT_SALES.COST_AMOUNT 為準）
	column STD_COST
		dataType: decimal
		formatString: #,##0
		sourceColumn: STD_COST

	partition DIM_PRODUCT = m
		mode: import
		source =
				let
				    Source = Oracle.Database(OracleServer, [HierarchicalNavigation = true]),
				    SchemaNav = Source{[Schema = OracleSchema]}[Data],
				    TableNav = SchemaNav{[Name = "DIM_PRODUCT"]}[Data],
				    Typed = Table.TransformColumnTypes(TableNav, {
				        {"PRODUCT_ID", Int64.Type},
				        {"PRODUCT_CODE", type text},
				        {"PRODUCT_NAME", type text},
				        {"CATEGORY", type text},
				        {"BRAND", type text},
				        {"LIST_PRICE", Currency.Type},
				        {"STD_COST", Currency.Type}
				    })
				in
				    Typed

