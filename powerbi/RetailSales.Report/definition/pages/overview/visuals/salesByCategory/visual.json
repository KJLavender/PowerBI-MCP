{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.1.0/schema.json",
  "name": "salesByCategory",
  "position": {
    "x": 640,
    "y": 470,
    "z": 600,
    "width": 620,
    "height": 240,
    "tabOrder": 600
  },
  "visual": {
    "visualType": "barChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "DIM_PRODUCT"
                    }
                  },
                  "Property": "CATEGORY"
                }
              },
              "queryRef": "DIM_PRODUCT.CATEGORY",
              "nativeQueryRef": "CATEGORY",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "FACT_SALES"
                    }
                  },
                  "Property": "銷售額"
                }
              },
              "queryRef": "FACT_SALES.銷售額",
              "nativeQueryRef": "銷售額"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'各品類銷售額'"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}