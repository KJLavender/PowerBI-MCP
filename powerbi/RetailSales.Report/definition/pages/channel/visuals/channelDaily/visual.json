{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.1.0/schema.json",
  "name": "channelDaily",
  "position": {
    "x": 20,
    "y": 80,
    "z": 200,
    "width": 1240,
    "height": 280,
    "tabOrder": 200
  },
  "visual": {
    "visualType": "lineChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "DIM_DATE"
                    }
                  },
                  "Property": "FULL_DATE"
                }
              },
              "queryRef": "DIM_DATE.FULL_DATE",
              "nativeQueryRef": "FULL_DATE",
              "active": true
            }
          ]
        },
        "Series": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "DIM_CHANNEL"
                    }
                  },
                  "Property": "CHANNEL_NAME"
                }
              },
              "queryRef": "DIM_CHANNEL.CHANNEL_NAME",
              "nativeQueryRef": "CHANNEL_NAME",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "FACT_SALES"
                    }
                  },
                  "Property": "訂單數"
                }
              },
              "queryRef": "FACT_SALES.訂單數",
              "nativeQueryRef": "訂單數"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'各通路每日訂單數'"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}