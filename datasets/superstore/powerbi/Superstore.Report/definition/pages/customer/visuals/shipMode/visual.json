        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Orders"
                    }
                  },
                  "Property": "銷售額"
                }
              },
              "queryRef": "Orders.銷售額",
              "nativeQueryRef": "銷售額"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Orders"
                    }
                  },
                  "Property": "運費"
                }
              },
              "queryRef": "Orders.運費",
              "nativeQueryRef": "運費"
            }
          ]
        }
      }
